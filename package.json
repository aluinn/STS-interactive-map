{
  "name": "sts-interactive-map",
  "description": "Interactive atlas of how scientific ideas moved between cultures, cities and periods, with the philosophy of science kept in the same frame.",
  "author": "Aluinn McDonald",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aluinn/STS-interactive-map.git"
  },
  "homepage": "https://sts-interactive-map.vercel.app",
  "bugs": {
    "url": "https://github.com/aluinn/STS-interactive-map/issues"
  },
  "keywords": [
    "history-of-science",
    "philosophy-of-science",
    "sts",
    "digital-humanities",
    "interactive-map",
    "d3",
    "react",
    "typescript"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "perf": "vitest run --config scripts/vitest.perf.config.ts",
    "verify:import": "node scripts/verify-offline-import.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vitest-dom": "^0.1.1"
  }
}
